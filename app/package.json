{
  "name": "@mdl/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "build:artefact": "MDL_ARTEFACT=1 vite build",
    "build:test": "MDL_DEMO=1 vite build --outDir dist-test",
    "test:e2e": "playwright test",
    "build:android": "MDL_ANDROID=1 vite build --outDir dist-android",
    "android": "npm run build:android && cap sync android"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "workbox-window": "^7.4.1"
  },
  "description": "L'application Mémoire des luttes",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@mdl/noyau": "*",
    "dexie": "^4.4.7",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4"
  },
  "license": "AGPL-3.0-or-later"
}
